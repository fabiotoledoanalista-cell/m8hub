check_ubuntu_version() {
  print_banner
  log_info "Verificando versão do Ubuntu (22.04/24.04)..."
  
  if [ -f /etc/os-release ]; then
    DETECTED_VERSION=$(grep "VERSION_ID" /etc/os-release | cut -d'"' -f2)
    DETECTED_NAME=$(grep "^NAME=" /etc/os-release | cut -d'"' -f2)
    DETECTED_CODENAME=$(grep "^VERSION_CODENAME=" /etc/os-release | cut -d'=' -f2)

    UBUNTU_VERSION="${DETECTED_VERSION}"
    UBUNTU_CODENAME="${DETECTED_CODENAME}"
    UBUNTU_NAME="${DETECTED_NAME}"

    if [ "${DETECTED_VERSION}" = "24.04" ]; then
      POSTGRES_VERSION="16"
      UBUNTU_EDITION="Ubuntu 24.04 LTS (Noble Numbat)"
      log_success "Ubuntu 24.04 LTS detectado ✓"
    elif [ "${DETECTED_VERSION}" = "22.04" ]; then
      POSTGRES_VERSION="14"
      UBUNTU_EDITION="Ubuntu 22.04 LTS (Jammy Jellyfish)"
      log_success "Ubuntu 22.04 LTS detectado ✓"
    else
      log_warning "Este instalador suporta oficialmente Ubuntu 22.04 e 24.04"
      log_warning "Versão detectada: ${DETECTED_NAME} ${DETECTED_VERSION}"
      read -p "Deseja continuar mesmo assim? (s/N): " continue_anyway
      if [[ ! "$continue_anyway" =~ ^[Ss]$ ]]; then
        log_error "Instalação cancelada"
        exit 1
      fi
      POSTGRES_VERSION="16"
      UBUNTU_EDITION="${DETECTED_NAME} ${DETECTED_VERSION}"
    fi
  else
    log_error "Não foi possível detectar a versão do Ubuntu"
    exit 1
  fi
  sleep 2
}

