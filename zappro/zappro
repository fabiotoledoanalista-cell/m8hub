system_node_install() {
  print_banner
  log_info "Instalando Node.js ${NODE_VERSION} e PostgreSQL ${POSTGRES_VERSION}..."
  sleep 2

  sudo su - root <<EOF
  set -Eeuo pipefail
  export DEBIAN_FRONTEND=noninteractive
  export NEEDRESTART_MODE=a
  export NEEDRESTART_SUSPEND=1
  APT_FLAGS="-yq -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"
  NVM_VERSION="v0.39.7"
  export NVM_DIR="\$HOME/.nvm"

  # Instalar/carregar NVM e Node.js 20 (idempotente)
  if [ ! -s "\$NVM_DIR/nvm.sh" ]; then
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/\${NVM_VERSION}/install.sh" | bash || {
      echo "ERRO: Falha ao instalar NVM (\${NVM_VERSION})."
      exit 1
    }
  fi

  if [ ! -s "\$NVM_DIR/nvm.sh" ]; then
    echo "ERRO: NVM nao encontrado em \$NVM_DIR/nvm.sh apos a instalacao."
    exit 1
  fi

  . "\$NVM_DIR/nvm.sh"

  if ! nvm ls 20 >/dev/null 2>&1; then
    nvm install 20 || {
      echo "ERRO: Falha ao instalar Node.js 20 via NVM."
      exit 1
    }
  fi

  nvm use 20 >/dev/null || {
    echo "ERRO: Falha ao ativar Node.js 20 via NVM."
    exit 1
  }
  nvm alias default 20 >/dev/null || {
    echo "ERRO: Falha ao definir Node.js 20 como padrao no NVM."
    exit 1
  }

  NODE20_VERSION="\$(nvm version 20)"
  if [ "\$NODE20_VERSION" = "N/A" ]; then
    echo "ERRO: NVM nao conseguiu resolver a versao Node 20."
    exit 1
  fi

  export PATH="\$NVM_DIR/versions/node/\$NODE20_VERSION/bin:\$PATH"

  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    echo "ERRO: node/npm nao encontrados apos configuracao do NVM."
    exit 1
  fi

  NODE_ACTUAL="\$(node -v)"
  case "\$NODE_ACTUAL" in
    v20.*) ;;
    *)
      echo "ERRO: Versao invalida do Node instalada: \$NODE_ACTUAL (esperado v20.x)."
      exit 1
      ;;
  esac

  # Disponibilizar node/npm/npx/corepack para usuarios e subshells sem depender de profile
  ln -sf "\$NVM_DIR/versions/node/\$NODE20_VERSION/bin/node" /usr/local/bin/node
  ln -sf "\$NVM_DIR/versions/node/\$NODE20_VERSION/bin/npm" /usr/local/bin/npm
  ln -sf "\$NVM_DIR/versions/node/\$NODE20_VERSION/bin/npx" /usr/local/bin/npx
  ln -sf "\$NVM_DIR/versions/node/\$NODE20_VERSION/bin/corepack" /usr/local/bin/corepack

  # Persistencia para sessoes futuras do root
  if ! grep -qxF 'export NVM_DIR="$HOME/.nvm"' /root/.bashrc; then
    cat >> /root/.bashrc <<'NVMEOF'
export NVM_DIR="$HOME/.nvm"
[ -s "\$NVM_DIR/nvm.sh" ] && . "\$NVM_DIR/nvm.sh"
NVMEOF
  fi
  
  # Instalar PostgreSQL conforme versao do Ubuntu detectada
  apt-get \${APT_FLAGS} install postgresql-${POSTGRES_VERSION} postgresql-client-${POSTGRES_VERSION} postgresql-contrib
  
  systemctl enable postgresql
  systemctl start postgresql
  
  # Configurar timezone
  timedatectl set-timezone America/Sao_Paulo
  
  # Verificar versões instaladas
  echo "Node.js: \$(node -v)"
  echo "npm: \$(npm -v)"
  echo "PostgreSQL: \$(psql --version)"
EOF

  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
  nvm use 20 >/dev/null
  export PATH="$NVM_DIR/versions/node/$(nvm version 20)/bin:$PATH"

  if ! node -v | grep -q '^v20\.'; then
    log_error "Falha na validacao do Node.js v20 no shell atual"
    exit 1
  fi

  log_success "Node.js $(node --version) instalado"
  log_success "PostgreSQL ${POSTGRES_VERSION} instalado"
  sleep 2
}

