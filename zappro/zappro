system_docker_install() {
  print_banner
  log_info "Instalando Docker..."
  sleep 2

  sudo su - root <<'EOF'
  export DEBIAN_FRONTEND=noninteractive
  export NEEDRESTART_MODE=a
  export NEEDRESTART_SUSPEND=1
  APT_FLAGS="-yq -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"
  UBUNTU_CODENAME=$(grep "^VERSION_CODENAME=" /etc/os-release | cut -d'=' -f2)
  
  # Remover versões antigas
  apt-get ${APT_FLAGS} remove docker docker-engine docker.io containerd runc 2>/dev/null || true
  
  # Instalar dependências
  apt-get ${APT_FLAGS} install ca-certificates curl gnupg lsb-release
  
  # Criar diretório de keyrings se não existir
  install -m 0755 -d /etc/apt/keyrings
  
  # Remover chave antiga se existir e baixar nova
  rm -f /etc/apt/keyrings/docker.gpg
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  
  # Remover repositório antigo e adicionar novo
  rm -f /etc/apt/sources.list.d/docker.list
  echo \
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
    ${UBUNTU_CODENAME} stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
  
  apt-get update -q
  apt-get ${APT_FLAGS} install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  
  systemctl start docker
  systemctl enable docker
EOF

  if ! command -v docker &> /dev/null; then
    log_error "Falha na instalação do Docker"
    exit 1
  fi

  log_success "Docker $(docker --version) instalado"
  sleep 2
}

